# Copia a .env (no se versiona). Cualquier endpoint compatible con OpenAI: OpenRouter, Ollama, etc.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=changeme
# Un modelo por enclave: cada enclave usa su propia instancia de cliente.
LLM_MODEL_ORCHESTRATOR=
LLM_MODEL_VAULT_WORKER=
LLM_MODEL_CUSTOMS=
LLM_MODEL_BASELINE=
# Modelos de Hugging Face en proceso (requirements-ml.txt). MODE: auto | required | off
GALVANIZE_MODE=auto
GALVANIZE_THRESHOLD=0.9802
WARD_MODE=auto
WARD_MAX_NEW_TOKENS=160
